# -----------------------------------------------------------
#  [*] my.cnf — the test container's MySQL server
#
#  MySQL 5.7.44 on its stock settings, as the bitlitas-mysql
#  service runs it — the character set (latin1 for the
#  server and the database, utf8mb4 for the tables the
#  migrations create), the collations and the strict SQL
#  mode stay untouched; skip-name-resolve is the official
#  image's own. The files sit where Dockerfile.tests copied
#  the server, and on the container's tmpfs mounts; the rest
#  is tuned for a database that lives for one run: small log
#  files, no flush on every commit, no doublewrite buffer, no
#  performance schema, and no native AIO, whose io_setup
#  slots the host shares among all its containers. It
#  listens on 127.0.0.1 only; the container has no other
#  network. run.sh passes it with --defaults-file, so no
#  other option file is read.
# -----------------------------------------------------------

[mysqld]
basedir                        = /opt/mysql
lc-messages-dir                = /opt/mysql/share/mysql
datadir                        = /var/lib/mysql
socket                         = /run/mysqld/mysqld.sock
pid-file                       = /run/mysqld/mysqld.pid
log-error                      = /run/mysqld/mysql.err
bind-address                   = 127.0.0.1
port                           = 3306
skip-name-resolve
secure-file-priv               = NULL
innodb_use_native_aio          = 0
innodb_buffer_pool_size        = 64M
innodb_log_file_size           = 8M
innodb_flush_log_at_trx_commit = 0
skip-innodb-doublewrite
performance_schema             = OFF
