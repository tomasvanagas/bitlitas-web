#!/usr/bin/env php
<?php

// -----------------------------------------------------------
//  [*] artisan — Laravel's command line
//
//  Runs the command named on the command line through the
//  console kernel — the framework's own, migrate among them,
//  and the app's bitlitas:sync — and exits with its status.
//  The line above the open tag lets the file run as a
//  program of its own.
//
//  Used by:
//    - seedDB.sh — the migrations of a fresh database
//    - the Dockerfile — the key generated when the image is
//      built
//    - the operator — bitlitas:sync, best as www-data
//    - tests/container/run.sh — the test database's
//      migrations
// -----------------------------------------------------------


// When the command began, for Laravel's timing
define('LARAVEL_START', microtime(true));

// Composer's autoloader, then the application
require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

// The command through the console kernel, with the
// terminal's arguments and output
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

// The kernel's shutdown hooks, then the command's status as
// the process's exit code
$kernel->terminate($input, $status);

exit($status);
